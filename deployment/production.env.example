APP_NAME=OpticValley
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://opticvalley.co

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# Create the database + user in hPanel → Databases → MySQL Databases
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Hostinger email (hPanel → Emails). Until configured, emails are written to the log.
MAIL_MAILER=log
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@opticvalley.co
MAIL_FROM_NAME="${APP_NAME}"

# First admin account (only used by the first seed). Leave password empty to
# have one generated and saved to shared/storage/app/private/admin-credentials.txt.
ADMIN_EMAIL=admin@opticvalley.co
ADMIN_PASSWORD=
SEED_DEMO_CATALOG=true
